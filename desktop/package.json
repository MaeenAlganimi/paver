{
  "name": "paver-desktop",
  "version": "1.0.0",
  "description": "Secure desktop wrapper for the hosted Paver workspace",
  "author": {
    "name": "Maeen Alganimi"
  },
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "build:windows": "electron-builder --win dir --x64 --config.win.signAndEditExecutable=false",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.paver.desktop",
    "productName": "Paver",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "Paver-${arch}.AppImage",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Paver-Setup-x64.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MaeenAlganimi",
        "repo": "paver",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
